# HuggingFace Dataset
HF_DATASET_NAME=sshaar/movierecaps-qa

# OpenAI Configuration
OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_MODEL=gpt-4-turbo-preview

# Anthropic Configuration
ANTHROPIC_API_KEY="your-anthropic-api-key-here"
ANTHROPIC_MODEL=claude-3-opus-20240229

# VLLM Configuration (for local models)
VLLM_MODEL_PATH=meta-llama/Llama-2-7b-chat-hf
VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_GPU_MEMORY_UTILIZATION=0.9

# Evaluator Configuration (LLM-as-a-judge)
EVALUATOR_PROVIDER=openai
EVALUATOR_MODEL=gpt-4-turbo-preview

# Generation Parameters
GENERATION_TEMPERATURE=0.7
EVALUATION_TEMPERATURE=0.0
MAX_GENERATION_TOKENS=512
MAX_EVALUATION_TOKENS=2048

# Batch Processing
BATCH_SIZE=1
